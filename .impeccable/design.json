  "narrative": {
    "northStar": "The Spatial Monitoring Station",
    "overview": "The user-confirmed world combines retro-futuristic monitoring instruments with grainy ocean/chrome imagery. Near-black fields, precise cyan/amber/magenta lines, dense asymmetric consoles, and technical typography support the capture-editing workflow. The text-free teal GauRush logo remains the identity anchor.\n\nArtwork and canvas studies supply atmosphere; real application recordings supply product evidence. The timeline is explicitly illustrative. This is an extraction of the implemented code, not a proposed replacement.",
    "keyCharacteristics": [
      "Cinematic image depth with thin square instrument frames.",
      "Large geometric headings and compact monospaced information.",
      "Asymmetric workstation density.",
      "Controllable live studies and real recordings."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Decorative telemetry must not imply measured application performance.",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "Keep explanatory text readable and distinguish decorative micro-labels from essential controls. The general paragraph rule is 13px; several implemented explanations override it to 12px, and supporting notes use 10–11px. Mobile hero copy is 12px. Decorative instrumentation falls to 7–10px, including some motion/reset controls. The code therefore does not satisfy a blanket 13px minimum.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve the teal logo and cyan/amber/magenta instrument palette.",
      "Do label illustrations and use real recordings for product behavior.",
      "Do preserve visible focus, manual motion controls and readable explanations.",
      "Do retain mobile two-column feeds and stacked consoles."
    ],
    "donts": [
      "Don't invent performance statistics from decorative telemetry.",
      "Don't replace square console framing with generic rounded cards.",
      "Don't add download buttons to the header or hero; the main download belongs in the final section.",
      "Don't apply decorative micro-label sizing to explanatory copy."
    ]
  }
